---
import { ETAPAS } from '../config';
---
<section id="mi-carro" class="bg-concreto" data-micarro data-etapas={JSON.stringify(ETAPAS)}>
  <div class="wrap flex flex-wrap gap-14 py-24">
    <div class="flex min-w-0 flex-[1_1_440px] flex-col gap-4.5">
      <h2 class="m-0 font-display text-[clamp(40px,4.6vw,60px)] leading-none font-extrabold tracking-[-0.5px] text-overol">¿Cómo va mi carro?</h2>
      <p class="lead m-0 text-[#2C3547]">Escribe la placa y mira en qué va. Lo actualizamos en cada paso.</p>
      <form data-track-form aria-label="Consultar estado del carro" class="flex flex-wrap items-end gap-2.5" novalidate>
        <div class="flex flex-[1_1_180px] flex-col gap-1.5">
          <label for="t-placa" class="label">Placa</label>
          <input id="t-placa" name="placa" maxlength="7" autocomplete="off" autocapitalize="characters" placeholder="ABC 123"
            class="min-h-13 rounded-lg border-[3px] border-tinta bg-placa px-3.5 py-2 font-display text-[26px] font-bold tracking-[3px] text-tinta uppercase" />
        </div>
        <button type="submit" class="btn-overol min-h-13">Consultar</button>
      </form>
      <p class="m-0 text-sm text-gris">Demo: prueba con la placa KXL 482.</p>
      <div aria-live="polite" data-track-out></div>
    </div>

    <div class="flex min-w-0 flex-[1_1_380px] flex-col gap-4.5">
      <h2 class="m-0 font-display text-[clamp(40px,4.6vw,60px)] leading-none font-extrabold tracking-[-0.5px] text-overol">Te avisamos antes de que se venza</h2>
      <p class="lead m-0 text-[#2C3547]">Deja tu placa y la fecha. Un mes antes te escribimos por WhatsApp para que no te pongan un comparendo.</p>
      <form data-rem-form aria-label="Recordatorio de vencimiento" class="flex flex-col gap-4" novalidate>
        <fieldset class="m-0 border-0 p-0">
          <legend class="label mb-2.5 p-0">¿Qué te recordamos?</legend>
          <div class="flex flex-wrap gap-2" data-group="kind">
            {['Técnico-mecánica', 'SOAT', 'Las dos'].map((k, i) => <button type="button" class="chip-light" data-value={k} aria-pressed={i === 0 ? 'true' : 'false'}>{k}</button>)}
          </div>
        </fieldset>
        <div class="grid grid-cols-[repeat(auto-fit,minmax(160px,1fr))] gap-3.5">
          <div class="flex flex-col gap-1.5">
            <label for="r-placa" class="label">Placa</label>
            <input id="r-placa" name="placa" maxlength="7" autocomplete="off" autocapitalize="characters" placeholder="ABC 123" class="field field-plate" />
          </div>
          <div class="flex flex-col gap-1.5">
            <label for="r-cel" class="label">Celular</label>
            <input id="r-cel" name="cel" type="tel" inputmode="numeric" placeholder="300 123 4567" class="field" />
          </div>
          <div class="flex flex-col gap-1.5">
            <label for="r-fecha" class="label">Se vence el</label>
            <input id="r-fecha" name="fecha" type="date" class="field" />
          </div>
        </div>
        <p data-rem-err role="alert" hidden class="alert m-0"></p>
        <button type="submit" class="btn-overol self-start">Activar recordatorio</button>
      </form>
      <div data-rem-done hidden role="status" class="flex flex-col gap-3 rounded-xl bg-white p-6">
        <p class="m-0 font-display text-[32px] leading-none font-extrabold text-overol">Recordatorio activo</p>
        <p data-rem-msg class="m-0 text-[17px] leading-relaxed text-[#2C3547]"></p>
        <button type="button" data-rem-again class="self-start py-2 text-base font-semibold text-overol underline">Agregar otro vehículo</button>
      </div>
    </div>
  </div>
</section>

<script>
  import { rpc, ApiError, chipGroup, placaLimpia, placaBonita, celularLimpio, placaValida, celularValido, iso2date, MESES, hoyBogota, waLink } from '../scripts/lib';
  const root = document.querySelector('[data-micarro]') as HTMLElement;
  const ETAPAS: string[] = JSON.parse(root.dataset.etapas!);
  const q = <T extends Element = HTMLElement>(s: string) => root.querySelector(s) as T;
  const upper = (e: Event) => { const t = e.target as HTMLInputElement; t.value = t.value.toUpperCase(); };
  root.querySelectorAll('input[name="placa"]').forEach((i) => i.addEventListener('input', upper));
  const esc = (s: string) => s.replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]!));

  // ---------- Seguimiento ----------
  type Track = { plate: string; model: string | null; stage: number; note: string | null; eta: string | null; stage_times: Record<string, string> };
  const out = q('[data-track-out]');
  const hora = (iso: string) => new Intl.DateTimeFormat('es-CO', { timeZone: 'America/Bogota', weekday: 'short', day: 'numeric', hour: 'numeric', minute: '2-digit' }).format(new Date(iso));

  q<HTMLFormElement>('[data-track-form]').addEventListener('submit', async (e) => {
    e.preventDefault();
    const p = placaLimpia((q<HTMLInputElement>('#t-placa')).value);
    if (!p) { out.innerHTML = ''; return; }
    out.innerHTML = '<p class="m-0 text-gris">Buscando…</p>';
    try {
      const t = await rpc<Track | null>('landing_track', { p_plate: p });
      if (!t) {
        out.innerHTML = `<p role="alert" class="m-0 rounded-lg bg-white px-4 py-3.5 text-base leading-relaxed text-[#2C3547]">No hay un carro con la placa ${esc(placaBonita(p))} en el taller. Revisa que esté bien escrita o escríbenos por WhatsApp.</p>`;
        return;
      }
      const items = ETAPAS.map((titulo, i) => {
        const n = i + 1;
        const state = n < t.stage ? 'done' : n === t.stage ? 'current' : 'todo';
        const when = t.stage_times?.[String(n)];
        const marker = state === 'done'
          ? '<span class="flex size-5.5 items-center justify-center rounded-full bg-overol text-white"><svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3.5" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg></span>'
          : state === 'current' ? '<span class="size-5.5 rounded-full border-[3px] border-tinta bg-placa"></span>'
          : '<span class="size-5.5 rounded-full border-2 border-[#9AA3B2] bg-white"></span>';
        const detail = state === 'current' && t.note ? esc(t.note) : when && state !== 'todo' ? esc(hora(when)) : '';
        const sr = state === 'done' ? ', completado' : state === 'current' ? ', en curso' : ', pendiente';
        return `<li class="flex gap-3.5"><div aria-hidden="true" class="flex w-6 flex-col items-center">${marker}${n < ETAPAS.length ? '<span class="min-h-6 w-0.5 flex-1 bg-[#C9CDD3]"></span>' : ''}</div>
          <div class="flex flex-col gap-0.5 pb-4.5"><span class="text-[17px] font-semibold ${state === 'todo' ? 'text-[#5A6478]' : 'text-tinta'}">${esc(titulo)}<span class="sr-only">${sr}</span></span>${detail ? `<span class="text-[15px] leading-snug text-gris">${detail}</span>` : ''}</div></li>`;
      }).join('');
      out.innerHTML = `<div class="flex flex-col gap-4.5 rounded-xl bg-white p-6">
        <div class="flex flex-wrap items-baseline justify-between gap-2"><span class="font-display text-[26px] font-bold">${esc(t.model || 'Tu carro')}, placa ${esc(placaBonita(t.plate))}</span>${t.eta ? `<span class="font-semibold text-overol">${esc(t.eta)}</span>` : ''}</div>
        <ol class="m-0 flex list-none flex-col p-0">${items}</ol>
        <a href="${waLink(`Hola, quiero saber cómo va mi carro de placa ${placaBonita(t.plate)}.`)}" target="_blank" rel="noopener" class="inline-flex min-h-11 items-center self-start font-semibold text-overol">Preguntar por WhatsApp</a></div>`;
    } catch (ex) {
      out.innerHTML = `<p role="alert" class="alert m-0">${esc((ex as ApiError).message)}</p>`;
    }
  });

  // ---------- Recordatorio ----------
  let kind = 'Técnico-mecánica';
  chipGroup(q('[data-group="kind"]'), (v) => (kind = v));
  const remForm = q<HTMLFormElement>('[data-rem-form]');
  const remErr = q('[data-rem-err]');
  const fecha = remForm.elements.namedItem('fecha') as HTMLInputElement;
  fecha.min = hoyBogota();
  const showErr = (m: string) => { remErr.textContent = m; remErr.hidden = false; };

  remForm.addEventListener('submit', async (e) => {
    e.preventDefault();
    remErr.hidden = true;
    const p = placaLimpia((remForm.elements.namedItem('placa') as HTMLInputElement).value);
    const c = celularLimpio((remForm.elements.namedItem('cel') as HTMLInputElement).value);
    if (!placaValida(p)) return showErr('Escribe la placa completa, por ejemplo KXL 482.');
    if (!celularValido(c)) return showErr('Escribe un celular de 10 dígitos que empiece por 3.');
    if (!fecha.value) return showErr('Elige la fecha en que se vence.');
    try {
      const on = await rpc<string>('landing_add_reminder', { p_plate: p, p_phone: c, p_kind: kind, p_due: fecha.value });
      const que = kind === 'Las dos' ? 'la técnico-mecánica y el SOAT' : kind === 'SOAT' ? 'el SOAT' : 'la técnico-mecánica';
      const d = iso2date(on); const v = iso2date(fecha.value);
      q('[data-rem-msg]').textContent = `Te escribiremos al ${c.slice(0, 3)} ${c.slice(3, 6)} ${c.slice(6)} el ${d.getUTCDate()} de ${MESES[d.getUTCMonth()]} para recordarte ${que} del carro de placa ${placaBonita(p)}, que se vence el ${v.getUTCDate()} de ${MESES[v.getUTCMonth()]} de ${v.getUTCFullYear()}.`;
      remForm.hidden = true;
      q('[data-rem-done]').hidden = false;
    } catch (ex) { showErr((ex as ApiError).message); }
  });
  q('[data-rem-again]').addEventListener('click', () => { remForm.reset(); remForm.hidden = false; q('[data-rem-done]').hidden = true; });
</script>
